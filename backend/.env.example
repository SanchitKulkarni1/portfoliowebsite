# Copy to .env and fill in. Never commit .env.

# --- Neo4j (AuraDB: console.neo4j.io -> your instance -> Connect) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- LLM (Google AI Studio key) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- HTTP ---
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8080,https://sanchitkulkarni.vercel.app
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=600
