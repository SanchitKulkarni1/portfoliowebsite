# Copy to .env and fill in. Never commit .env.

# --- Neo4j (AuraDB: console.neo4j.io -> your instance -> Connect) ---
# You can paste Aura's downloaded credentials file as-is (NEO4J_USERNAME also works).
# Newer Aura instances name the database after the instance id, not "neo4j".
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- LLM (Google AI Studio key) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- HTTP ---
# Comma-separated origins allowed to call the API from a browser.
ALLOWED_ORIGINS=http://localhost:8080,https://sanchitkulkarni.vercel.app
# Optional regex (full match) for origins you can't list, e.g. every Vercel preview deploy.
# ALLOWED_ORIGIN_REGEX=https://frontend(-[a-z0-9-]+)?-sanchit-kulkarnis-projects\.vercel\.app
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=600
